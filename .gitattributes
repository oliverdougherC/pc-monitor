# Keep the repo diff-clean: normalize in the index, pick a sane checkout eol.
* text=auto

*.png  binary
*.jpg  binary
*.ttf  binary
*.otf  binary
*.ico  binary

# Source and manifests normalize to LF; PowerShell uses CRLF on Windows.
*.cs   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf
