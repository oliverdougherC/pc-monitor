# Keep the repo diff-clean: normalize in the index, pick a sane checkout eol.
* text=auto

*.png  binary
*.jpg  binary
*.ttf  binary
*.otf  binary
*.ico  binary

# Python/yaml are read by tools on both platforms; PowerShell wants CRLF.
*.py   text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf
