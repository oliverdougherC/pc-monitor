# runtime / env
.venv/
__pycache__/
*.pyc
screencap.png
tmp
log.log
probe.txt
lhm_dump.txt
# Journal of an in-progress USB disable/enable (app/panel.py). Transient, machine
# specific, and its presence means "a device needs re-enabling" - never a source file.
.panel_reset_pending

# The observer's three files (app/liveness.py): the beat the watchdog reads, the marker
# saying a shutdown was on purpose, and the restart budget. All per-machine runtime
# state - and committing the stop marker would let one developer's Ctrl-C silently
# disable recovery on every machine that later checks out this branch.
.heartbeat
.stopped
.restarts

# boot.log is the diagnostic path that still works with no vendored logger
# (app/bootlog.py), so it is written on every start; watchdog.log is the observer's
# incident record. Both are logs, not sources.
boot.log
watchdog.log
watchdog.log.old

# theme/render scratch
preview/
shots/

# Vendored upstream library (1.1 GB, 1.05 GB of it theme artwork).
# Tracked here is only the pin + provenance note; see vendor/README.md and
# tools/vendor_lock.ps1.
/vendor/*
!/vendor/README.md
!/vendor/LOCK.txt

# PresentMon: the binary is a download (tools/fetch_presentmon.ps1), but its
# sha256 pin and provenance have to be tracked - with only LOCK.txt gone, a fresh
# clone cannot tell which build it should have, and `-Verify` has nothing to
# check against. Re-including the directory first is not optional: git cannot
# un-ignore a file that lives under an excluded one.
!/vendor/presentmon/
/vendor/presentmon/*
!/vendor/presentmon/LOCK.txt
